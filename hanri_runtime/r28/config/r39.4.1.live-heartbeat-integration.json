{
  "schema_version": 1,
  "policy_version": "39.4.1-live-heartbeat-integration-v1",
  "mode": "LIVE_OUTCOME_SIDECAR_AFTER_FULL_ATTENTION",
  "integration_rules": {
    "run_outcome_after_full_attention": true,
    "retry_pending_outcome_on_next_heartbeat": true,
    "do_not_change_cadence_controller": true,
    "preserve_task_action_path": true,
    "runtime_refresh_uses_live_attention_lease": true,
    "outcome_failure_surfaces_task_failure": true,
    "scheduler_xml_must_remain_byte_equivalent": true
  },
  "effect_boundary": {
    "proposal_only": true,
    "local_state_write_only": true,
    "provider_calls": false,
    "scheduler_install": false,
    "scheduler_modify": false,
    "human_decision_execution": false,
    "self_apply": false,
    "skill_install": false,
    "system_write": false,
    "operator_message": false,
    "auto_dispatch": false,
    "external_messages": false,
    "can_trade": false,
    "capital_permission": "DENY"
  }
}
