{
  "schema_version": 1,
  "policy_version": "39.5.1-autonomous-learning-integration-v1",
  "mode": "AUTONOMOUS_IMPROVEMENT_LEARNING_SIDECAR",
  "upstream_policy_version": "39.4.1-live-heartbeat-integration-v1",
  "learning_policy_version": "39.5.0-improvement-learning-v1",
  "heartbeat_minutes": 5,
  "semantic_rules": {
    "upstream_outcome_must_be_complete_before_learning": true,
    "learning_runs_after_successful_outcome_execution": true,
    "learning_retries_on_next_heartbeat_when_pending": true,
    "first_live_heartbeat_bootstraps_learning_if_state_missing": true,
    "unchanged_outcome_digest_yields_no_delta": true,
    "negative_outcomes_outrank_reinforcement": true,
    "causation_is_not_claimed": true,
    "generalization_requires_human_review": true
  },
  "runtime_refresh": {
    "stable_task_action_path_unchanged": true,
    "scheduler_xml_change_authorized": false,
    "live_lease_required": true,
    "rollback_required_on_post_swap_failure": true
  },
  "effect_boundary": {
    "proposal_only": true,
    "local_state_write_only": true,
    "provider_calls": false,
    "scheduler_install": false,
    "scheduler_modify": false,
    "human_decision_execution": false,
    "self_apply": false,
    "skill_install": false,
    "system_write": false,
    "operator_message": false,
    "auto_dispatch": false,
    "external_messages": false,
    "can_trade": false,
    "capital_permission": "DENY"
  }
}
