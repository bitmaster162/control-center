{
  "schema_version": 1,
  "policy_version": "39.2.0-producer-adapters-v1",
  "mode": "READ_ONLY_PRODUCER_SCAN_TO_LOCAL_ATTENTION_INBOX",
  "max_file_bytes": 4194304,
