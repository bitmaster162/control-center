{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/hanri-effect-execution-receipt.schema.json",
  "title": "HANRI R37 Bounded Projection Execution Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "policy_version",
    "generated_at",
    "status",
    "effect_rung",
    "action_hash",
    "plan_sha256",
    "provider_target_id",
    "expected_before_sha256",
    "observed_before_sha256",
    "expected_after_sha256",
    "rollback_attempted",
    "rollback_verified",
    "execution_effects_performed",
    "can_trade",
    "capital_permission",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "policy_version": {"const": "37.1.0-bounded-projection-executor-v1"},
    "status": {"enum": ["PASS", "PRECONDITION_FAILED", "ROLLED_BACK", "ROLLBACK_FAILED"]},
    "effect_rung": {"enum": ["TARGET_READBACK", "SEMANTIC_EFFECT_VERIFIED"]},
    "action_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider_target_id": {"const": "15GG9ElRV6Ed0gzGkB2b02JumHS58jU2r"},
    "expected_before_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observed_before_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observed_after_sha256": {"type": ["string", "null"]},
    "rollback_attempted": {"type": "boolean"},
    "rollback_verified": {"type": "boolean"},
    "execution_effects_performed": {"type": "integer", "minimum": 0, "maximum": 2},
    "can_trade": {"const": false},
    "capital_permission": {"const": "DENY"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
