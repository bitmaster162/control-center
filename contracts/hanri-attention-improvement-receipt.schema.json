{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-center.local/contracts/hanri-attention-improvement-receipt.schema.json",
  "title": "HANRI Attention-over-Attention Improvement Receipt",
  "type": "object",
  "required": ["schema_version", "policy_version", "run_id", "generated_at", "mission", "findings", "proposals", "meta_audit", "capabilities", "effect_boundary", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "policy_version": {"type": "string", "pattern": "^39\\."},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "mission": {"const": "AUDIT_SELF_AGENTS_SYSTEMS_OPERATOR_AND_PROPOSE_EVIDENCE_BOUND_IMPROVEMENTS"},
    "findings": {"type": "array"},
    "proposals": {"type": "array", "items": {"type": "object", "required": ["proposal_id", "kind", "domain", "evidence_refs", "authority", "requires_human_acceptance", "effect_authorized"]}},
    "meta_audit": {"type": "object", "required": ["attention_over_attention", "domain_counts", "blind_spots", "coverage_complete", "negative_outcome_count"]},
    "capabilities": {"type": "object"},
    "effect_boundary": {
      "type": "object",
      "required": ["proposal_only", "self_apply", "skill_install", "system_write", "operator_message", "auto_dispatch", "external_messages", "can_trade", "capital_permission"],
      "properties": {
        "proposal_only": {"const": true},
        "self_apply": {"const": false},
        "skill_install": {"const": false},
        "system_write": {"const": false},
        "operator_message": {"const": false},
        "auto_dispatch": {"const": false},
        "external_messages": {"const": false},
        "can_trade": {"const": false},
        "capital_permission": {"const": "DENY"}
      }
    },
    "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
