{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-center.local/contracts/freshness-ledger.schema.json",
  "title": "HANRI per-surface freshness ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "policy", "surfaces", "invariants"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_readback_is_not_operational_freshness", "current_requires_target_state_proof", "missing_discovery_never_authorizes_rerun", "promotion_is_human_gated"],
      "properties": {
        "source_readback_is_not_operational_freshness": {"const": true},
        "current_requires_target_state_proof": {"const": true},
        "missing_discovery_never_authorizes_rerun": {"const": true},
        "promotion_is_human_gated": {"const": true}
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "owner", "source_available", "operational_status", "freshness", "last_verified_at", "fresh_readback_at", "current_proof", "proof_refs", "observations", "missing_proof", "promotion_allowed", "promotion_rule"],
        "properties": {
          "id": {"enum": ["continuity-os", "archive-os", "decision-governor", "fable-5", "codex-01", "codex-05"]},
          "name": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "source_available": {"type": "boolean"},
          "operational_status": {"enum": ["UNKNOWN", "STALE_EVIDENCE", "DO_NOT_TOUCH", "OPERATIONAL"]},
          "freshness": {"enum": ["STALE", "CURRENT"]},
          "last_verified_at": {"type": ["string", "null"], "format": "date-time"},
          "fresh_readback_at": {"type": "string", "format": "date-time"},
          "current_proof": {"type": "boolean"},
          "proof_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "observations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "missing_proof": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "promotion_allowed": {"type": "boolean"},
          "promotion_rule": {"type": "string", "minLength": 1}
        }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["can_trade", "capital_permission", "self_application", "auto_dispatch", "auto_promotion"],
      "properties": {
        "can_trade": {"const": false},
        "capital_permission": {"const": "DENY"},
        "self_application": {"const": false},
        "auto_dispatch": {"const": false},
        "auto_promotion": {"const": false}
      }
    }
  }
}
