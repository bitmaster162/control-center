{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:control-plane:reconciliation-result:v1",
  "title": "Reconciliation Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "result_id",
    "source_cut_id",
    "subject_id",
    "truth_status",
    "semantic_status",
    "route",
    "reason_codes",
    "selected_refs",
    "contradiction_refs",
    "human_ripe",
    "authority_granted",
    "auto_execute",
    "effects",
    "readback_required",
    "readback_status",
    "can_trade",
    "capital_permission"
  ],
  "properties": {
    "schema": {
      "const": "control_plane.reconciliation_result.v1"
    },
    "result_id": {
      "type": "string",
      "pattern": "^rec-[0-9a-f]{64}$"
    },
    "source_cut_id": {
      "type": "string",
      "pattern": "^cut-[0-9a-f]{64}$"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "truth_status": {
      "enum": [
        "CURRENT",
        "CURRENT_WITH_CONDITIONS",
        "STALE",
        "SUPERSEDED",
        "CONFLICT",
        "UNKNOWN"
      ]
    },
    "semantic_status": {
      "enum": [
        "UNREVIEWED",
        "ACCEPTED",
        "HOLD",
        "REVISE",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "route": {
      "enum": [
        "NO_ACTION",
        "CONTROL_CENTER",
        "HUMAN_GATE",
        "OWNER_ONLY",
        "BLOCKED"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "selected_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradiction_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_ripe": {
      "type": "boolean"
    },
    "authority_granted": {
      "const": false
    },
    "auto_execute": {
      "const": false
    },
    "effects": {
      "type": "object"
    },
    "can_trade": {
      "const": false
    },
    "capital_permission": {
      "const": "DENY"
    },
    "readback_required": {
      "type": "boolean"
    },
    "readback_status": {
      "enum": [
        "NOT_DUE",
        "REQUIRED",
        "VERIFIED",
        "FAILED",
        "UNKNOWN"
      ]
    }
  }
}
